{
  "name": "app-transfer",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de envio de apoio financeiro para estudantes (MVP em modo SIMULATION).",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @app/database generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @app/database generate",
    "db:migrate": "pnpm --filter @app/database migrate",
    "db:migrate:deploy": "pnpm --filter @app/database migrate:deploy",
    "db:seed": "pnpm --filter @app/database seed",
    "db:studio": "pnpm --filter @app/database studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
