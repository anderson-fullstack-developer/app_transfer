// =============================================================================
// app-transfer — schema Prisma (Fase 2)
//
// Regras (doc, seccoes 12, 28, 37, 44):
//   - valores monetarios em minor units inteiros (BigInt), NUNCA Float;
//   - taxas de cambio como Decimal(18, 8);
//   - unique index em StudentProfile.usernameNormalized;
//   - TransferEvent e AuditLog sao append-only (so createdAt, nunca apagados);
//   - sem soft delete em entidades financeiras;
//   - IDs internos UUID; referencias publicas TRF-XXXX / QTE-XXXX.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Ligacao direta (sem connection pooler) usada pelas migrations. Em Docker
  // local aponta para o mesmo sitio; na Neon e o host sem "-pooler".
  directUrl = env("DIRECT_URL")
}

// --- Enums (espelham packages/shared/src/domain/enums.ts) --------------------

enum UserRole {
  STUDENT
  SENDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum QuoteStatus {
  ACTIVE
  EXPIRED
  CONSUMED
}

enum TransferStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  SENT_TO_PROVIDER
  DELIVERED
  FAILED
  CANCELLED
  REFUNDED
}

enum TransferEventType {
  CREATED
  STATUS_CHANGED
  PROVIDER_UPDATE
  PAYMENT_ATTEMPT
  NOTE
}

enum PaymentAttemptStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WHATSAPP
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// --- Identidade -------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  role            UserRole
  status          UserStatus @default(ACTIVE)
  emailVerified   Boolean    @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  studentProfile     StudentProfile?
  senderProfile      SenderProfile?
  notifications      Notification[]
  auditLogs          AuditLog[]          @relation("AuditLogActor")
  kycVerifications   KycVerification[]
  idempotencyKeys    IdempotencyKey[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// --- Sessoes / tokens de autenticacao ---------------------------------------

/// Um refresh token emitido a um utilizador. Guardamos apenas o hash SHA-256.
/// Rotacao: ao usar um refresh token, e revogado e substituido por outro da
/// mesma `familyId`. Se um token ja revogado for reutilizado, revoga-se a
/// familia toda (deteccao de roubo de token).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Tokens de uso unico para verificacao de email e reset de password.
/// Guardamos apenas o hash; o valor cru vai no link enviado por email.
model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model StudentProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  username          String
  usernameNormalized String   @unique
  displayName       String
  dateOfBirth       DateTime  @db.Date
  country           String
  city              String
  university        String
  phone             String
  kycStatus         KycStatus @default(NOT_STARTED)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotesReceived     Quote[]              @relation("QuoteStudent")
  transfersReceived  Transfer[]           @relation("TransferStudent")
  favoritedBy        FavoriteBeneficiary[]

  @@map("student_profiles")
}

model SenderProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String
  country     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotesCreated  Quote[]              @relation("QuoteSender")
  transfersSent  Transfer[]           @relation("TransferSender")
  favorites      FavoriteBeneficiary[]

  @@map("sender_profiles")
}

// --- Quote -----------------------------------------------------------------

model Quote {
  id                    String      @id @default(uuid()) @db.Uuid
  reference             String      @unique
  senderId              String      @db.Uuid
  studentId             String      @db.Uuid
  sourceCurrency        String
  destinationCurrency   String
  sourceAmountMinor     BigInt
  feeAmountMinor        BigInt
  destinationAmountMinor BigInt
  exchangeRate          Decimal     @db.Decimal(18, 8)
  provider              String
  status                QuoteStatus @default(ACTIVE)
  expiresAt             DateTime
  createdAt             DateTime    @default(now())

  sender   SenderProfile  @relation("QuoteSender", fields: [senderId], references: [id], onDelete: Restrict)
  student  StudentProfile @relation("QuoteStudent", fields: [studentId], references: [id], onDelete: Restrict)
  transfer Transfer?

  @@index([senderId])
  @@index([studentId])
  @@index([status, expiresAt])
  @@map("quotes")
}

// --- Transfer ------------------------------------------------------------

model Transfer {
  id                     String         @id @default(uuid()) @db.Uuid
  reference              String         @unique
  senderId               String         @db.Uuid
  studentId              String         @db.Uuid
  quoteId                String         @unique @db.Uuid
  sourceCurrency         String
  destinationCurrency    String
  sourceAmountMinor      BigInt
  feeAmountMinor         BigInt
  destinationAmountMinor BigInt
  exchangeRate           Decimal        @db.Decimal(18, 8)
  status                 TransferStatus @default(DRAFT)
  provider               String
  providerTransferId     String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  completedAt            DateTime?

  sender          SenderProfile   @relation("TransferSender", fields: [senderId], references: [id], onDelete: Restrict)
  student         StudentProfile  @relation("TransferStudent", fields: [studentId], references: [id], onDelete: Restrict)
  quote           Quote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  events          TransferEvent[]
  paymentAttempts PaymentAttempt[]

  @@index([senderId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@map("transfers")
}

/// Historico imutavel de uma transferencia. Append-only: nunca UPDATE nem DELETE.
model TransferEvent {
  id             String            @id @default(uuid()) @db.Uuid
  transferId     String            @db.Uuid
  previousStatus TransferStatus?
  newStatus      TransferStatus
  eventType      TransferEventType
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId, createdAt])
  @@map("transfer_events")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  transferId        String               @db.Uuid
  status            PaymentAttemptStatus @default(PENDING)
  amountMinor       BigInt
  currency          String
  provider          String
  providerReference String?
  failureReason     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("payment_attempts")
}

// --- Beneficiarios favoritos --------------------------------------------

model FavoriteBeneficiary {
  id        String   @id @default(uuid()) @db.Uuid
  senderId  String   @db.Uuid
  studentId String   @db.Uuid
  alias     String?
  createdAt DateTime @default(now())

  sender  SenderProfile  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([senderId, studentId])
  @@index([senderId])
  @@map("favorite_beneficiaries")
}

// --- KYC (arquitetura apenas; sem verificacao real nesta fase) ----------

model KycVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  provider  String
  status    KycStatus @default(PENDING)
  sessionId String?
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_verifications")
}

// --- Notificacoes ------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  type      String
  title     String
  body      String
  readAt    DateTime?
  metadata  Json                @default("{}")
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// --- Audit log ------------------------------------------------------------

/// Registo de operacoes relevantes. Append-only. Nunca guardar passwords,
/// tokens ou documentos completos (doc, seccao 13).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// --- Idempotencia -------------------------------------------------------

/// Garante que um retry de POST /transfers nao cria duas transferencias
/// (doc, seccao 11). Persistente, com a mesma chave + scope unicos.
model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  key            String
  scope          String
  requestHash    String
  userId         String?   @db.Uuid
  responseStatus Int?
  responseBody   Json?
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([key, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
