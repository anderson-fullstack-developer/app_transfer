# =============================================================================
# app-transfer — exemplo de configuracao
# Copiar para `.env` na raiz:  cp .env.example .env
# NUNCA commitar o `.env` real. Todos os valores abaixo sao seguros para dev.
# =============================================================================

# --- Geral -------------------------------------------------------------------
NODE_ENV=development
# Modo da plataforma. SIMULATION = nenhuma transferencia representa dinheiro real.
APP_MODE=SIMULATION

# --- URLs / portas ---------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Origens permitidas para CORS (separadas por virgula). Explicito, nunca "*".
CORS_ORIGINS=http://localhost:3000

# --- Base de dados (PostgreSQL) --------------------------------------------
# Opcao A - Docker local (docker-compose.yml deste repo):
#   DATABASE_URL=postgresql://app:app@localhost:5432/app_transfer?schema=public
#   DIRECT_URL=postgresql://app:app@localhost:5432/app_transfer?schema=public
# Opcao B - Neon (cloud). DATABASE_URL = ligacao pooled; DIRECT_URL = ligacao direta
#   (sem "-pooler" no host), usada pelas migrations.
DATABASE_URL=postgresql://app:app@localhost:5432/app_transfer?schema=public
DIRECT_URL=postgresql://app:app@localhost:5432/app_transfer?schema=public

# --- Redis ---------------------------------------------------------------------
# Usado para rate limiting e cache. Jobs (BullMQ) so quando houver uso real.
REDIS_URL=redis://localhost:6379

# --- Autenticacao ------------------------------------------------------------
# Gerar valores fortes:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
# Segundos.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
COOKIE_DOMAIN=localhost
# Em producao: true (exige HTTPS).
COOKIE_SECURE=false

# --- Payment provider --------------------------------------------------------
# mock | wise | nium | thunes  (apenas "mock" implementado nesta fase)
PAYMENT_PROVIDER=mock
# Taxa de cambio simulada 1 EUR -> X MAD.
MOCK_EUR_MAD_RATE=10.85
# Fee variavel em % do montante enviado.
MOCK_TRANSFER_FEE_PERCENT=2
# Fee fixa adicional, em minor units da moeda de origem (cents de EUR).
MOCK_TRANSFER_FIXED_FEE_MINOR=0

# --- Regras de negocio -----------------------------------------------------
# Montantes em minor units (cents de EUR). 1000 = 10,00 EUR.
TRANSFER_MIN_SOURCE_MINOR=1000
TRANSFER_MAX_SOURCE_MINOR=500000
# Validade de uma quote, em segundos.
QUOTE_TTL_SECONDS=600

# --- Email -------------------------------------------------------------------
# console | smtp   (console = escreve o email no stdout, sem enviar nada)
EMAIL_PROVIDER=console
EMAIL_FROM="app-transfer <no-reply@apptransfer.test>"

# --- Endpoints de desenvolvimento -----------------------------------------
# Ativa /api/v1/dev/* (ex.: avancar manualmente uma transferencia mock).
# TEM de ser false em producao.
ENABLE_DEV_ENDPOINTS=true

# --- Frontend (variaveis expostas ao browser, prefixo NEXT_PUBLIC_) --------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_MODE=SIMULATION
